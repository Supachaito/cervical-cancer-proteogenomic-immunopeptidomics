# Example configuration for Paper 3 public scripts
PAPER3_ROOT=/path/to/paper3_workspace
PAPER3_WES_ROOT=/path/to/WES_Project_Analysis
PAPER3_OUTPUT_ROOT=/path/to/paper3_results
# Optional convenience search roots (use ; on Windows, : on macOS/Linux)
# PAPER3_SEARCH_ROOTS=/path/one:/path/two
PAPER3_ENABLE_SHELL_HISTORY=0
